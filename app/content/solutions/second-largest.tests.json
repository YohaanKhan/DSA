{
  "problem": "Read n, then n integers. Print the second largest DISTINCT value on its own line. If fewer than two distinct values exist, print -2147483648 (INT_MIN).",
  "language": "c",
  "topic": "logic-errors",
  "tests": [
    { "name": "ascending", "stdin": "5\n1 2 3 4 5", "expectedStdout": "4" },
    { "name": "all equal", "stdin": "4\n7 7 7 7", "expectedStdout": "-2147483648", "edgeCase": true },
    { "name": "empty", "stdin": "0\n", "expectedStdout": "-2147483648", "edgeCase": true, "hidden": true },
    { "name": "negatives with duplicate max", "stdin": "3\n-5 -2 -2", "expectedStdout": "-5", "edgeCase": true },
    { "name": "unsorted", "stdin": "6\n3 9 1 9 4 2", "expectedStdout": "4" },
    { "name": "single element", "stdin": "1\n42", "expectedStdout": "-2147483648", "edgeCase": true, "hidden": true }
  ]
}
