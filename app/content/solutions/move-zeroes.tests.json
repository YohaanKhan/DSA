{
  "problem": "Read n, then n integers. Move every zero to the end while preserving the relative order of the non-zero values, in place. Print the resulting array space-separated on one line.",
  "language": "c",
  "topic": "logic-errors",
  "tests": [
    { "name": "zeroes interleaved", "stdin": "5\n0 1 0 3 12", "expectedStdout": "1 3 12 0 0" },
    { "name": "no zeroes", "stdin": "3\n1 2 3", "expectedStdout": "1 2 3", "edgeCase": true },
    { "name": "all zeroes", "stdin": "4\n0 0 0 0", "expectedStdout": "0 0 0 0", "edgeCase": true },
    { "name": "single zero", "stdin": "1\n0", "expectedStdout": "0", "edgeCase": true, "hidden": true },
    { "name": "leading zeroes", "stdin": "6\n0 0 5 0 7 0", "expectedStdout": "5 7 0 0 0 0", "hidden": true }
  ]
}
